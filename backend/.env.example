# Local development. Copy to backend/.env and fill in.
# In production these are set as Environment Variables in the Vercel dashboard.

# Local MongoDB, or a MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URL=mongodb://127.0.0.1:27017

# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional: comma-separated list of allowed frontend origins for CORS (local dev only)
# CLIENT_URLS=http://localhost:5173
